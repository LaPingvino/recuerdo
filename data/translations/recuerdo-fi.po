msgstr "Avaa ensin sanaoppitunti Recuerdo-sovelluksessa."

msgid "Open for handing in"
msgstr "Avaa palautuksille"

msgid "Open the test"
msgstr "Avaa koe"

msgid "Password"
msgstr "Salasana"

