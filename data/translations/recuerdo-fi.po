msgstr "Kirjaudu koepalvelimelle"

msgid "Log out"
msgstr "Kirjaudu ulos"

msgid "New group"
msgstr "Uusi ryhmä"

msgid "New test"
msgstr "Uusi koe"

msgid "New test of a lesson file…"
msgstr "Uusi koe oppituntitiedostosta…"

msgid "New test of the open lesson"
msgstr "Uusi koe avoimesta oppitunnista"

