msgstr "Käyttäjätilejä ja ryhmiä hallitaan palvelimen verkkosivulla."

msgid "Add many"
msgstr "Lisää monta kerralla"

msgid "Add these accounts"
msgstr "Lisää nämä käyttäjätilit"

msgid "Admin"
msgstr "Ylläpitäjä"

msgid "Back"
msgstr "Takaisin"

msgid "Back to the test"
msgstr "Takaisin kokeeseen"

msgid "Close for handing in"
msgstr "Sulje palautukset"

msgid "Closed"
msgstr "Suljettu"

msgid "Count as right"
msgstr "Laske oikeaksi"

msgid "Count as wrong"
msgstr "Laske vääräksi"

msgid "Delete the group"
msgstr "Poista ryhmä"

msgid "Delete the test"
msgstr "Poista koe"

msgid "Fill in the server, your name and your password."
msgstr "Täytä palvelin, nimesi ja salasanasi."

msgid "Given"
msgstr "Annettu vastaus"

msgid "Given to"
msgstr "Vastaanottajat"

msgid "Group %s"
msgstr "Ryhmä %s"

