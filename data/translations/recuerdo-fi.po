msgstr "Julkaise kaikki tulokset"

msgid "Publish this result"
msgstr "Julkaise tämä tulos"

msgid "Published"
msgstr "Julkaistu"

msgid "Published: the students can see their results."
msgstr "Julkaistu: oppilaat näkevät tuloksensa."

msgid "Refresh"
msgstr "Päivitä"

msgid "Remove %s"
msgstr "Poista %s"

msgid "Result ready"
msgstr "Tulos valmis"

msgid "Right (your teacher's decision)"
msgstr "Oikein (opettajasi päätös)"

msgid "Right answers"
msgstr "Oikeat vastaukset"

msgid "Role"
msgstr "Rooli"

msgid "Role…"
msgstr "Rooli…"

msgid "Score"
msgstr "Pisteet"

msgid "See the result"
msgstr "Katso tulos"

msgid "Server"
msgstr "Palvelin"

msgid "Status"
msgstr "Tila"

msgid "Student"
msgstr "Oppilas"

msgid "Take tests from a test server, or give them as a teacher"
msgstr "Tee kokeita koepalvelimelta tai anna niitä opettajana"

msgid "Take the test"
msgstr "Tee koe"

msgid "Take the tests your teacher gave you."
msgstr "Tee kokeet, jotka opettajasi antoi sinulle."

