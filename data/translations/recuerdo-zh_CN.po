msgid "Dark"
msgstr "深色"

msgid "Light"
msgstr "浅色"

msgid "Make only word lessons: no topography or media lessons when making a new lesson"
msgstr "只创建单词课程：创建新课程时不提供地形学或媒体课程"

msgid "System"
msgstr "跟随系统"

msgid "The colours of Recuerdo: as the system has them, light or dark"
msgstr "Recuerdo 的颜色：跟随系统、浅色或深色"

msgid "Theme"
msgstr "主题"

msgid "Words only"
msgstr "仅单词"
