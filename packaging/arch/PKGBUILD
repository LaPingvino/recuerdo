# Maintainer: Joop Kiefte <ikojba@gmail.com>
#
# Builds Recuerdo from the latest commit on GitHub:
#   cd packaging/arch && makepkg -si
pkgname=recuerdo-git
_pkgname=recuerdo
pkgver=r0
pkgrel=1
pkgdesc="Vocabulary, topography and media trainer; OpenTeacher in Go with Qt"
arch=('x86_64' 'aarch64')
url="https://github.com/LaPingvino/recuerdo"
license=('GPL-3.0-or-later')
depends=('glibc' 'qt6-base')
optdepends=('qt6-wayland: native Wayland windows'
            'qt6-translations: the texts of OK, Cancel and the file dialogs in your language'
            'espeak-ng: pronouncing questions'
            'tesseract: reading word lists from pictures'
            'tesseract-data-eng: English for tesseract (other languages: tesseract-data-*)'
            'libreoffice: exporting to Word, Excel and other office formats')
makedepends=('go' 'git' 'pkgconf' 'qt6-base')
provides=('recuerdo')
conflicts=('recuerdo')
source=("$_pkgname-src::git+https://github.com/LaPingvino/recuerdo.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname-src"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$_pkgname-src"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -modcacherw"
  go build -ldflags="-s -w -X main.appVersion=$pkgver" -o recuerdo ./cmd/recuerdo
  # the web version (recuerdo serve), with its translations; WebAssembly
  # has no PIE builds
  GOFLAGS="-trimpath -modcacherw" ./scripts/build-web.sh "$srcdir/web-dist"
}

package() {
  cd "$srcdir/$_pkgname-src"
  install -Dm755 recuerdo "$pkgdir/usr/bin/recuerdo"
  # data/ is found in ../share/recuerdo relative to the binary
  install -dm755 "$pkgdir/usr/share/recuerdo"
  cp -r data "$pkgdir/usr/share/recuerdo/"
  install -dm755 "$pkgdir/usr/share/recuerdo/web"
  cp -r "$srcdir/web-dist/." "$pkgdir/usr/share/recuerdo/web/"
  install -Dm644 packaging/recuerdo.desktop "$pkgdir/usr/share/applications/eu.kiefte.Recuerdo.desktop"
  install -Dm644 assets/recuerdo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/recuerdo.svg"
  install -Dm644 assets/recuerdo.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/recuerdo.png"
  install -Dm644 README.md "$pkgdir/usr/share/doc/recuerdo/README.md"
}
